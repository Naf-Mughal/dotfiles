@@ -1699,6 +1699,11 @@ namespace umbriel {
           m_gammaDirty = false;
         }
         if (commitOk && hasBuffer) {
+          if (m_keepBuffer != nullptr) {
+            wlr_buffer_unlock(m_keepBuffer);
+          }
+          m_keepBuffer = wlr_buffer_lock(state.buffer);
+          m_keepAlivePending = false;
           m_lastCommitTearing = commitTearing;
           m_trackingPresentation = true;
