#!/bin/bash
# graceful-power reboot|shutdown|logout
#
# Windows-style power actions: ask every open window to close (apps save their
# session, prompt about unsaved work, etc.), wait for them, and if any app holds
# out, show "N apps are preventing restart" with "Restart anyway" / "Cancel".
# Closing the holdouts yourself (after saving) continues automatically.
#
# Used by Noctalia via [shell.session.power], which the Graceful Power plugin
# (nafeel/graceful-power) writes to ~/.config/noctalia/graceful-power.toml.

GRACE=10      # seconds apps get to close on their own
PROMPT=120    # seconds the "preventing restart" prompt waits before cancelling

case "$1" in
    reboot)            cmd=(systemctl reboot);   verb="Restart" ;;
    shutdown|poweroff) cmd=(systemctl poweroff); verb="Shut down" ;;
    logout)            cmd=(umbriel msg session-quit:skip-confirmation); verb="Sign out" ;;
    *) echo "usage: graceful-power reboot|shutdown|logout" >&2; exit 2 ;;
esac

# Only one run at a time (double-clicks, repeated keybinds).
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/graceful-power.lock"
flock -n 9 || exit 0

windows() { umbriel windows --json 2>/dev/null | jq -r '.[] | "\(.id)\t\(.app_id)"'; }
count()   { windows | grep -c . ; }

# 1. Politely ask every window to close.
while IFS=$'\t' read -r id _; do
    [ -n "$id" ] && umbriel msg "window-close:$id" >/dev/null 2>&1
done < <(windows)

# 2. Give them time to exit.
for ((i = 0; i < GRACE * 2; i++)); do
    [ "$(count)" -eq 0 ] && exec "${cmd[@]}"
    sleep 0.5
done

# 3. Something is still open (unsaved work, a "close tabs?" dialog, a hung app).
apps=$(windows | cut -f2 | sort -u | paste -sd ', ')
n=$(count)
choice=$(mktemp)
notify-send -u critical -a "Power" -i system-reboot \
    -A force="$verb anyway" -A cancel="Cancel" \
    "$n app(s) are preventing ${verb,,}" \
    "Still open: $apps. Save your work and close them, or choose $verb anyway." \
    >"$choice" 2>/dev/null &
notify_pid=$!

for ((i = 0; i < PROMPT * 2; i++)); do
    if [ "$(count)" -eq 0 ]; then              # user closed the holdouts
        kill "$notify_pid" 2>/dev/null; rm -f "$choice"; exec "${cmd[@]}"
    fi
    if ! kill -0 "$notify_pid" 2>/dev/null; then   # user picked a button / dismissed
        if [ "$(cat "$choice")" = "force" ]; then rm -f "$choice"; exec "${cmd[@]}"; fi
        break
    fi
    sleep 0.5
done

kill "$notify_pid" 2>/dev/null
rm -f "$choice"
notify-send -a "Power" "${verb} cancelled" "Your apps were left open."
exit 1
