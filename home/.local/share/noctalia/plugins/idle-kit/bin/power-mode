#!/usr/bin/env bash
# power-mode — Windows-style automatic battery saver.
#   Plugged in              → balanced
#   On battery, >= 30%      → balanced
#   On battery, <  30%      → power-saver   ("Battery saver turned on")
#   Plug in while saver on  → balanced      ("Battery saver turned off")
#
# Only acts when the *automatic* target changes, so if you pick Performance
# yourself it stays until the next real transition (plug/unplug/crossing 30%).
set -u
THRESHOLD="${POWER_SAVER_THRESHOLD:-30}"
state="${XDG_STATE_HOME:-$HOME/.local/state}/idle-kit"
mkdir -p "$state"

on_ac() {
  local have_battery=0 ps
  for ps in /sys/class/power_supply/*; do
    [[ -r "$ps/type" ]] || continue
    case "$(<"$ps/type")" in
      Mains|USB) [[ "$(cat "$ps/online" 2>/dev/null)" == 1 ]] && return 0 ;;
      Battery)   have_battery=1 ;;
    esac
  done
  (( have_battery == 0 ))
}

percent="${NOCTALIA_BATTERY_PERCENT:-}"
if ! [[ "$percent" =~ ^[0-9]+$ ]]; then
  percent=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)
fi
[[ "$percent" =~ ^[0-9]+$ ]] || percent=100

# Noctalia's state env is fresher than sysfs right at the plug event.
case "${NOCTALIA_BATTERY_STATE:-}" in
  charging|fully_charged|pending_charge) ac=1 ;;
  discharging|empty|pending_discharge)   ac=0 ;;
  *) if on_ac; then ac=1; else ac=0; fi ;;
esac

if (( ac == 0 && percent < THRESHOLD )); then target=power-saver; else target=balanced; fi

last=$(cat "$state/power-mode" 2>/dev/null || echo none)
[[ "$target" == "$last" && "${1:-}" != --force ]] && exit 0
echo "$target" > "$state/power-mode"

noctalia msg power-set "$target" >/dev/null 2>&1 || powerprofilesctl set "$target" 2>/dev/null

if [[ "$last" != none ]]; then
  if [[ "$target" == power-saver ]]; then
    notify-send -i battery-low "Battery saver turned on" "Battery at ${percent}%. Plug in to restore Balanced."
  elif [[ "$last" == power-saver ]]; then
    notify-send -i battery-good-charging "Battery saver turned off" "Back to Balanced."
  fi
fi
