#!/usr/bin/env bash
# idle-profile — switch Noctalia idle timeouts between AC and battery.
#   idle-profile auto      detect power source and apply
#   idle-profile ac|battery force a profile
#   idle-profile apply     re-apply the current profile (after editing profiles/*.toml)
#   idle-profile status    show what's active
set -euo pipefail

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia"
profiles="$(cd "$(dirname "$0")/../profiles" && pwd)"   # shipped with the plugin
active="$cfg/zz-idle-active.toml"          # zz- so it merges after your other files
state="${XDG_STATE_HOME:-$HOME/.local/state}/idle-kit"
mkdir -p "$state"

on_ac() {
  local have_battery=0 ps
  for ps in /sys/class/power_supply/*; do
    [[ -r "$ps/type" ]] || continue
    case "$(<"$ps/type")" in
      Mains|USB) [[ -r "$ps/online" && "$(<"$ps/online")" == 1 ]] && return 0 ;;
      Battery)   have_battery=1 ;;
    esac
  done
  # No battery at all → desktop → treat as AC.
  (( have_battery == 0 ))
}

apply() {
  local p="$1"
  [[ -f "$profiles/$p.toml" ]] || { echo "missing $profiles/$p.toml" >&2; exit 1; }
  # Skip if nothing changed (avoids needless reloads on every battery event).
  if [[ -f "$active" ]] && cmp -s "$profiles/$p.toml" "$active"; then
    echo "$p" > "$state/current"; return 0
  fi
  cp -f "$profiles/$p.toml" "$active.tmp" && mv -f "$active.tmp" "$active"
  echo "$p" > "$state/current"
  noctalia msg config-reload >/dev/null 2>&1 || true   # file watch also picks it up
  logger -t idle-profile "applied $p"
}

case "${1:-auto}" in
  auto)        if on_ac; then apply ac; else apply battery; fi ;;
  ac|battery)  apply "$1" ;;
  apply)       rm -f "$active"; apply "$(cat "$state/current" 2>/dev/null || echo ac)" ;;
  status)
    echo "profile : $(cat "$state/current" 2>/dev/null || echo none)"
    if on_ac; then echo "power   : AC"; else echo "power   : battery"; fi
    grep -E '^\s*(timeout|action|enabled)' "$active" 2>/dev/null | sed 's/^/  /'
    if grep -qs '^\[idle' "${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/settings.toml"; then
      echo "WARNING : ~/.local/state/noctalia/settings.toml has [idle] GUI overrides — they win over this kit."
    fi ;;
  *) echo "usage: idle-profile {auto|ac|battery|apply|status}" >&2; exit 2 ;;
esac
