#!/bin/bash
# Lock with Cave Abode before every suspend (lid close, power key,
# `systemctl suspend`, idle), in place of Noctalia's lock_before_suspend:
# holds a logind delay inhibitor, and on PrepareForSleep starts the lock,
# gives it a moment to cover the screens, then lets the suspend go ahead.
# The plugin service runs this while "Lock before suspend" is on.
set -u
# Drop fds leaked from Noctalia (other commands' pipes): holding their write
# ends would keep Noctalia waiting forever for EOF and freeze the shell.
for fd in /proc/$$/fd/*; do
    fd=${fd##*/}
    [ "$fd" -gt 2 ] && eval "exec $fd>&-" 2>/dev/null
done
root="$(cd "$(dirname "$0")/.." && pwd)"
trap 'trap - EXIT INT TERM; kill 0 2>/dev/null' EXIT INT TERM

inhibitor=
inhibit() {
    systemd-inhibit --what=sleep --mode=delay --who="Cave Abode" \
        --why="Lock the screen before sleep" sleep infinity &
    inhibitor=$!
}

inhibit
echo "watching for sleep"
gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 |
while read -r line; do
    case "$line" in
    *"PrepareForSleep (true,)"*)
        echo "sleeping: locking"
        "$root/bin/cave-abode-lock" &
        sleep 1
        [ -n "$inhibitor" ] && kill "$inhibitor" 2>/dev/null
        inhibitor=
        ;;
    *"PrepareForSleep (false,)"*)
        echo "resumed"
        [ -n "$inhibitor" ] || inhibit
        ;;
    esac
done
