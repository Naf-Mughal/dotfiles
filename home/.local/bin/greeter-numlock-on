#!/usr/bin/env python3
# Turn Num Lock on at the noctalia-greeter login screen.
# Sets `numlock = true` under [keyboard] in greeter.toml, keeping a backup.
# Run with sudo: sudo ~/.local/bin/greeter-numlock-on
import os, re, shutil, sys, time

path = "/var/lib/noctalia-greeter/greeter.toml"
if os.geteuid() != 0:
    sys.exit("run with sudo")

text = open(path).read() if os.path.exists(path) else ""
if os.path.exists(path):
    shutil.copy2(path, f"{path}.bak-numlock-{time.strftime('%Y%m%d-%H%M%S')}")

lines = text.splitlines()
start = next((i for i, l in enumerate(lines) if l.strip() == "[keyboard]"), None)
if start is None:
    lines += (["", "[keyboard]", "numlock = true"] if lines else ["[keyboard]", "numlock = true"])
else:
    end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith("[")), len(lines))
    key = next((i for i in range(start + 1, end) if re.match(r"\s*numlock\s*=", lines[i])), None)
    if key is None:
        lines.insert(start + 1, "numlock = true")
    else:
        lines[key] = "numlock = true"

st = os.stat(path) if os.path.exists(path) else None
with open(path, "w") as f:
    f.write("\n".join(lines) + "\n")
if st:
    os.chown(path, st.st_uid, st.st_gid)
    os.chmod(path, st.st_mode)
else:
    shutil.chown(path, "greeter", "greeter")
    os.chmod(path, 0o640)
print(f"numlock = true set in {path}")
print("\n".join(l for l in lines if l.strip()))
