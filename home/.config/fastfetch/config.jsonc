{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ],
  "logo": {
    "color": {
      "1": "#ffb663",
      "2": "#e4c263"
    }
  },
  "display": {
    "color": {
      "keys": "#ffb6a0",
      "title": "#e4c2b7"
    },
    "percent": {
      "color": {
        "green": "#aa928c",
        "yellow": "#f5b29d",
        "red": "#f68488"
      }
    }
  }
}
