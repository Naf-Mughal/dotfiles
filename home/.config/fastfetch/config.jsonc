{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ],
  "logo": {
    "color": {
      "1": "#63ebeb",
      "2": "#63c4c4"
    }
  },
  "display": {
    "color": {
      "keys": "#ebebeb",
      "title": "#c4c4c4"
    },
    "percent": {
      "color": {
        "green": "#9e9e9e",
        "yellow": "#c4c4c4",
        "red": "#f6857a"
      }
    }
  }
}
